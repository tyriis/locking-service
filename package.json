{
  "name": "locking-service",
  "version": "0.2.0",
  "description": "Locking service rewrite",
  "type": "module",
  "imports": {
    "#root/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/index.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/timestring": "7.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fastify/etag": "6.2.1",
    "@fastify/otel": "0.21.3",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "timestring": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
